---
const facilities = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17c0-3.5 4-6 9-6s9 2.5 9 6"/><line x1="12" y1="11" x2="9" y2="22"/><circle cx="17" cy="5" r="2"/></svg>`,
    title: 'Acceso directo a la playa',
    desc: 'Salida privada del camping directamente a la playa. Solo 2 minutos caminando desde tu parcela a las aguas del Atlántico.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h1.5a2.5 2.5 0 0 1 0 5H4V4z"/><path d="M4 9v3"/><path d="M7 4v12"/><line x1="10" y1="14" x2="10" y2="16"/><line x1="13" y1="14" x2="13" y2="16"/><line x1="16" y1="14" x2="16" y2="16"/><line x1="10" y1="18" x2="10" y2="20"/><line x1="13" y1="18" x2="13" y2="20"/><line x1="16" y1="18" x2="16" y2="20"/></svg>`,
    title: 'Duchas y aseos limpios',
    desc: 'Personal de limpieza permanente durante todo el día. Duchas con agua caliente y buena presión en todo momento.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="2" x2="8" y2="22"/><path d="M5 2v6a3 3 0 0 0 6 0V2"/><line x1="19" y1="2" x2="19" y2="22"/><path d="M19 2a5 5 0 0 1 0 10"/></svg>`,
    title: 'Bar-Restaurante',
    desc: 'Cocina casera a buen precio. Desayunos, comidas y cenas. Célebre por sus serranitos, hamburguesas y menú del día.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    title: 'Supermercado',
    desc: 'Tienda con productos de primera necesidad dentro del camping. Precios razonables para que no necesites salir.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    title: 'Animación y actividades',
    desc: 'En temporada alta: karaoke, cine de verano, juegos infantiles y monitores para los más pequeños.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.57a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.57a2 2 0 0 0-1.34-2.23z"/></svg>`,
    title: 'Lavandería',
    desc: 'Servicio de lavandería disponible en el camping para que puedas mantener tu ropa limpia durante la estancia.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>`,
    title: 'Admite mascotas',
    desc: 'Puedes traer a tu perro. Una de las playas kilométricas más bonitas del litoral gaditano para pasear con tu mascota.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
    title: 'Seguridad 24h',
    desc: 'Vigilancia permanente con control de acceso. Puedes descansar con total tranquilidad durante toda tu estancia.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M12 2a14.5 14.5 0 0 1 0 20"/><path d="M2 12h20"/></svg>`,
    title: 'Pistas deportivas',
    desc: 'Instalaciones deportivas para disfrutar en familia. Parque infantil con juegos para los más pequeños.',
  },
];
---

<section class="facilities" id="instalaciones">
  <div class="container">
    <div class="section-header">
      <p class="section-tag">Instalaciones</p>
      <h2 class="section-title">Todo lo que necesitas</h2>
      <div class="divider"></div>
      <p class="section-subtitle">
        Nuestro camping dispone de todas las instalaciones para que tu estancia sea
        cómoda y memorable, sin necesidad de salir.
      </p>
    </div>

    <div class="facilities-grid">
      {facilities.map((facility) => (
        <div class="facility-card">
          <div class="facility-icon" set:html={facility.icon}></div>
          <h3 class="facility-title">{facility.title}</h3>
          <p class="facility-desc">{facility.desc}</p>
        </div>
      ))}
    </div>

    <div class="facilities-banner">
      <div class="banner-content">
        <h3>¿Cerca de qué estamos?</h3>
        <p>A 8 km de Rota · 10 km de Chipiona · 25 km de Sanlúcar de Barrameda · 50 km de Cádiz · 60 km del Circuito de Jerez</p>
      </div>
      <div class="banner-points">
        <div class="point">
          <span class="point-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></span>
          <span>Gran Premio MotoGP Jerez</span>
        </div>
        <div class="point">
          <span class="point-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="2" x2="8" y2="22"/><path d="M5 2v6a3 3 0 0 0 6 0V2"/><line x1="19" y1="2" x2="19" y2="22"/><path d="M19 2a5 5 0 0 1 0 10"/></svg></span>
          <span>Gastronomía gaditana cercana</span>
        </div>
        <div class="point">
          <span class="point-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"/><line x1="12" y1="8" x2="12" y2="22"/><path d="M5 15H2a10 10 0 0 0 20 0h-3"/></svg></span>
          <span>Base Naval de Rota</span>
        </div>
        <div class="point">
          <span class="point-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
          <span>Mercadillo domingos y martes</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .facilities {
    padding: 6rem 0;
    background: var(--color-white);
  }

  .section-tag {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-light);
    margin-bottom: 0.75rem;
  }

  .divider {
    width: 60px;
    height: 4px;
    background: var(--color-secondary);
    border-radius: 2px;
    margin: 1rem auto;
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .facility-card {
    background: var(--color-sand);
    border-radius: var(--radius-md);
    padding: 2rem 1.75rem;
    transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
    border: 1px solid transparent;
  }

  .facility-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    background: var(--color-white);
    border-color: var(--color-sand-dark);
  }

  .facility-icon {
    margin-bottom: 1rem;
    color: var(--color-primary);
    display: flex;
    align-items: center;
  }

  .facility-title {
    font-size: 1.1rem;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
  }

  .facility-desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin: 0;
  }

  .facilities-banner {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-lg);
    padding: 2.5rem 3rem;
    color: white;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .banner-content {
    flex: 1;
  }

  .banner-content h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .banner-content p {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin: 0;
  }

  .banner-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 2rem;
    flex-shrink: 0;
  }

  .point {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.9);
  }

  .point-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  @media (max-width: 1000px) {
    .facilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .facilities-banner {
      flex-direction: column;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .facilities {
      padding: 4rem 0;
    }

    .facilities-grid {
      grid-template-columns: 1fr;
    }

    .facilities-banner {
      padding: 2rem 1.5rem;
    }

    .banner-points {
      grid-template-columns: 1fr;
    }
  }
</style>
